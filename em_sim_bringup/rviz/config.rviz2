Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Path1
        - /Path2
      Splitter Ratio: 0.5
    Tree Height: 569
  - Class: rviz_common/ViewsPanel
    Expanded: False
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        robot_0/base_link:
          Value: true
        robot_1/base_link:
          Value: true
        robot_2/base_link:
          Value: true
        robot_3/base_link:
          Value: true
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          robot_0/base_link:
            {}
          robot_1/base_link:
            {}
          robot_2/base_link:
            {}
          robot_3/base_link:
            {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
